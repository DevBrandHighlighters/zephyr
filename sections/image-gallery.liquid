{% style %}
  .custom-skewElem {
    will-change: transform;
  }
{% endstyle %}

<section class="page-width">
  {% for block in section.blocks %}
    <img
      src="{{ block.settings.image | img_url: 'master' }}"
      alt="{{ block.settings.image.alt | default: 'Gallery Image' }}"
      class="custom-skewElem"
    >
  {% endfor %}
</section>

<script>
  function clamp(value, min = -10, max = 10) {
    return Math.min(Math.max(value, min), max);
  }

  let proxy = { skew: 0 },
      skewSetter = gsap.quickSetter('.custom-skewElem', 'skewY', 'deg');

  ScrollTrigger.create({
    onUpdate: (self) => {
      let skew = clamp(self.getVelocity() / -300);
      if (Math.abs(skew) > Math.abs(proxy.skew)) {
        proxy.skew = skew;
        gsap.to(proxy, {
          skew: 0,
          duration: 0.8,
          ease: 'power3',
          overwrite: true,
          onUpdate: () => skewSetter(proxy.skew),
        });
      }
    },
    start: 'top center',
    end: 'bottom center',
    scrub: 1,
  });

  gsap.set('.custom-skewElem', { transformOrigin: 'right center' });
</script>
{% schema %}
{
  "name": "Image Gallery",
  "settings": [
    {
      "type": "header",
      "content": "Image Gallery"
    },
    {
      "type": "range",
      "id": "max_skew",
      "label": "Maximum Skew Angle",
      "min": 0,
      "max": 45,
      "step": 1,
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "category": "Image Gallery"
    }
  ]
}
{% endschema %}
