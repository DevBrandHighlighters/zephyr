{% style %}
  .custom-skewElem {
    will-change: transform;
  }
{% endstyle %}

<section class="page-width">
  {% for block in section.blocks %}
    <img
      src="{{ block.settings.image | img_url: '1080x1080' }}"
      alt="{{ block.settings.image.alt | default: 'Gallery Image' }}"
      class="custom-skewElem"
    >
  {% endfor %}
</section>

{% schema %}
{
  "name": "Image Gallery",
  "settings": [
    {
      "type": "header",
      "content": "Image Gallery"
    },
    {
      "type": "range",
      "id": "max_skew",
      "label": "Maximum Skew Angle",
      "min": 0,
      "max": 45,
      "step": 1,
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "category": "Image Gallery"
    }
  ]
}
{% endschema %}
