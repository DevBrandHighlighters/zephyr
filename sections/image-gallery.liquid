<section class="page-width">
  {% for block in section.blocks %}
    <img src="{{ block.settings.image | img_url: '600x600' }}" alt="" class="custom-skewElem">
  {% endfor %}
</section>
<script>
  let proxy = { skew: 0 },
    skewSetter = gsap.quickSetter('.custom-skewElem', 'skewY', 'deg'),
  ScrollTrigger.create({
    onUpdate: (self) => {
      let skew = clamp(self.getVelocity() / -300);
      if (Math.abs(skew) > Math.abs(proxy.skew)) {
        proxy.skew = skew;
        gsap.to(proxy, {
          skew: 0,
          duration: 0.8,
          ease: 'power3',
          overwrite: true,
          onUpdate: () => skewSetter(proxy.skew),
        });
      }
    },
  });
  gsap.set('.custom-skewElem', { transformOrigin: 'right center', force3D: true });
</script>
{% schema %}
{
  "name": "Image Gallery",
  "settings": [
    {
      "type": "header",
      "content": "Image Gallery"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "category": "Image Gallery"
    }
  ]
}
{% endschema %}
