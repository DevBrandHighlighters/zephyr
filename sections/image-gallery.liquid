<section>
  <img width="600" height="600" src="https://picsum.photos/600/600?random=1" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=2" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=3" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=4" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=5" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=6" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=7" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=8" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=9" alt="" class="custom-skewElem">
  <img width="600" height="600" src="https://picsum.photos/600/600?random=10" alt="" class="custom-skewElem">
</section>
<script>
  let proxy = { skew: 0 },
    skewSetter = gsap.quickSetter('.custom-skewElem', 'skewY', 'deg'), // fast
    clamp = gsap.utils.clamp(-20, 20); // don't let the skew go beyond 20 degrees.

  ScrollTrigger.create({
    onUpdate: (self) => {
      let skew = clamp(self.getVelocity() / -300);
      if (Math.abs(skew) > Math.abs(proxy.skew)) {
        proxy.skew = skew;
        gsap.to(proxy, {
          skew: 0,
          duration: 0.8,
          ease: 'power3',
          overwrite: true,
          onUpdate: () => skewSetter(proxy.skew),
        });
      }
    },
  });
  gsap.set('.custom-skewElem', { transformOrigin: 'right center', force3D: true });
</script>
