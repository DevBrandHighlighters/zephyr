{{ 'dynamic-collisions-section.css' | asset_url | stylesheet_tag }}

<div class="mouse-effect">
  <div class="circle"></div>
  <div class="circle-follow"></div>
</div>

<section class="dynamic_banner hide-text">
  <div class="dynamic_banner-inner">
    <div class="top-desc">
      <h5>{{ section.settings.section_title }}</h5>
      <h6>{{ section.settings.section_subtitle }}</h6>
      <span></span>
    </div>
    <div class="bottom-desc">
      <div class="left-desc">
        <div class="desc-inner">
          <h5>{{ section.settings.left_title }}</h5>
          <h6>{{ section.settings.left_title1 }}</h6>
        </div>
      </div>
      <div class="middle-desc">
        <h2>{{ section.settings.main_title }}</h2>
      </div>
      <div class="right-desc">
        <div class="desc-inner">
          <span>{{ section.settings.social_heading }}</span>
          <ul>
            <li>
              <a href="#">
                <i class="fa-brands fa-x-twitter"></i>
              </a>
            </li>
            <li>
              <a href="#">
                <i class="fa-brands fa-facebook-f"></i>
              </a>
            </li>
            <li>
              <a href="#">
                <i class="fa-brands fa-instagram"></i>
              </a>
            </li>
            <li>
              <a href="#">
                <i class="fa-brands fa-youtube"></i>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <canvas class="webgl" id="webgl"></canvas>
  <span class="rotated-text hide-text">{{ section.settings.main_title }}</span>
</section>

<script src="{{ 'new-banner.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "New GSAP Banner",
  "settings": [
    {
      "type": "header",
      "content": "Main Text"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "Your Store Name"
    },
    {
      "type": "header",
      "content": "Top Left Text"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Despersion Collisions"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Research & Development"
    },
    {
      "type": "header",
      "content": "Bottom Left Text"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Left Title",
      "default": "Pink & Rose Gold"
    },
    {
      "type": "text",
      "id": "left_title1",
      "label": "Left Title 1",
      "default": "Lighting & Material Study"
    },
    {
      "type": "text",
      "id": "left_subtitle",
      "label": "Left Subtitle",
      "default": "Social Links"
    },
    {
      "type": "header",
      "content": "Bottom Right Text"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social Heading",
      "default": "Follow Us"
    }
  ],
  "presets": [
    {
      "name": "New GSAP Banner"
    }
  ]
}
{% endschema %}
